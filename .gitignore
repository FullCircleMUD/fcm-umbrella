# Nested working repos — version-controlled independently by their own remotes.
/design/
/ops/

# The rebuild workspace and the old tree it replaces. Ignored whole rather than
# repo by repo, so a new shard or view gamedir is covered the day it appears —
# the named list this replaces pointed at /src/game-rebuild/ for weeks after
# that folder was renamed, leaving the live rebuild tracked by accident.
/src/*
/src_old/*

# Grouped nested repos — content/ holds the game-content repos, utilities/ the
# supporting tools. Ignored as a whole so a new repo is covered the day it
# appears; see the libraries/ block below for why.
/content/*
!/content/README.md
/utilities/*
!/utilities/README.md

# Every library is its own repo. Ignored as a whole rather than named one by
# one, so a new library is covered the day it appears — the per-repo list this
# replaces went stale three times over, and a `git add -A` from the umbrella
# root then commits them as bare gitlinks.
/libraries/*
!/libraries/README.md

# Local-only, regenerable — not tracked.
.DS_Store

# Python bytecode.
__pycache__/
*.pyc

# Process IDs written by a running server — per-instance, regenerated on every start.
*.pid

# Working files for in-flight analysis — notes, not documentation.
/.scratch/

# Personal, machine-local instructions — not synced.
/CLAUDE.local.md